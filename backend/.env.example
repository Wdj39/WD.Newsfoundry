# Connexion à la base PostgreSQL (locale via Docker, ou Railway en production)
DATABASE_URL='postgresql://user:password@localhost:5432/newsfoundry'

# Clé secrète de signature des tokens JWT (longue chaîne aléatoire, différente en production)
# Pour en générer une : uv run python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=''

# Origines autorisées à appeler l'API (séparées par des virgules)
CORS_ORIGINS='http://localhost:3000'

# Clés des fournisseurs de LLM (Gemini = modèle principal, Groq = secours)
GEMINI_API_KEY=''
GROQ_API_KEY=''

# Clé de l'API d'actualités https://worldnewsapi.com/
WORLD_NEWS_API_KEY=''
